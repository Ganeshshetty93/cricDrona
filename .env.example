# Public browser configuration (safe to expose; protected by RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Node API configuration: use the SAME project and public key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Never use a service-role/secret key in any VITE_ variable.
# Backend-only role management and administrative CLI access (never committed or bundled)
SUPABASE_SECRET_KEY=
