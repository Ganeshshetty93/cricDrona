{
  "name": "cricdrona",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:api": "node server/dev.js",
    "server": "node server/dev.js",
    "dev:full": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "dev:design": "node scripts/design-preview.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "account:repair": "node scripts/repair-account.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:design": "playwright test --config playwright.preview.config.js",
    "test:auth": "playwright test --config playwright.auth.config.js"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.10"
  }
}
